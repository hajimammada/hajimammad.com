{
    "name": "Corporate Analytical Theme",
    "dataColors": [
        "#2C3E50",
        "#18BC9C",
        "#E74C3C",
        "#F39C12",
        "#3498DB",
        "#9B59B6",
        "#7F8C8D"
    ],
    "background": "#FFFFFF",
    "foreground": "#333333",
    "tableAccent": "#2C3E50",
    "visualStyles": {
        "*": {
            "*": {
                "outspace": [{ "color": { "solid": { "color": "#F4F5F7" } } }],
                "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
                "visualHeader": [{ "show": true }],
                "title": [{ 
                    "show": true, 
                    "fontColor": { "solid": { "color": "#2C3E50" } },
                    "fontSize": 12,
                    "fontFamily": "Segoe UI Semibold"
                }]
            }
        }
    }
}
